{
  "expo": {
    "name": "STARK",
    "slug": "stark",
    "scheme": "stark",
    "version": "0.3.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.stark.personal",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.stark.personal",
      "permissions": []
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./public/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ]
  }
}
